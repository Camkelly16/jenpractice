pipeline {
    agent any
    tools {
        maven 'Maven'
    }
    parameters {
        booleanParam(name: 'SKIP_TESTS', defaultValue: false, description: 'Skip running the test suite')
        choice(name: 'ENVIRONMENT', choices: ['dev', 'staging', 'prod'], description: 'Which environment this build is for')
    }
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        stage('Build') {
            steps {
                sh 'mvn -B clean package -DskipTests=${params.SKIP_TESTS}'
            }
        }
        stage('Test & Analysis') {
            parallel {
                stage('Test & Coverage') {
                    when {
                        expression { return !params.SKIP_TESTS }
                    }
                    steps {
                        sh 'mvn -B test'
                    }
                    post {
                        always {
                            junit 'target/surefire-reports/*.xml'
                            archiveArtifacts artifacts: 'target/site/jacoco/**', allowEmptyArchive: true
                        }
                    }
                }
                stage('Static Analysis') {
                    steps {
                        sh 'mvn -B checkstyle:check'
                    }
                }
            }
        }
        stage('Approve Release') {
            steps {
                timeout(time: 15, unit: 'MINUTES') {
                    input message: "Deploy build to ${params.ENVIRONMENT}?", ok: 'Proceed'
                }
            }
        }
        stage('Archive') {
            steps {
                archiveArtifacts artifacts: 'target/*.jar', fingerprint: true
            }
        }
    }
}
